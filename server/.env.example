# LLM (OpenRouter Qwen)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/hunter-alpha
OPENROUTER_QUESTIONS_MODEL=openrouter/hunter-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2

# Vector DB (Pinecone)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=agentic-rag-index

# PostgreSQL
DATABASE_URL=postgresql://agent:agent_password@127.0.0.1:5433/agent_db?schema=public

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT="Agentic RAG"